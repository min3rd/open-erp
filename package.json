{
  "name": "open-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Open-ERP monorepo automation: Quarkus backend, Angular 22 web, Ionic 8 mobile, @open-erp/cli and Docker/K8s infra (cross-platform via Node)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "help": "node scripts/run.mjs help",
    "infra": "node scripts/run.mjs infra",
    "infra:mail": "node scripts/run.mjs infra mail",
    "infra:kafka": "node scripts/run.mjs infra kafka",
    "infra:mongo": "node scripts/run.mjs infra mongo",
    "infra:storage": "node scripts/run.mjs infra storage",
    "infra:registry": "node scripts/run.mjs infra registry",
    "infra:full": "node scripts/run.mjs infra full",
    "infra:ps": "node scripts/run.mjs infra-ps",
    "infra:down": "node scripts/run.mjs infra-down",
    "keys:jwt": "node scripts/run.mjs keys",
    "backend": "docker compose --profile dev up -d backend-dev",
    "prebackend": "npm run keys:jwt",
    "backend:test": "mvn -f src/backend/pom.xml test",
    "backend:build": "mvn -f src/backend/pom.xml -DskipTests package",
    "plugin:catalog:test": "mvn -f plugins/catalog/pom.xml test",
    "plugin:catalog:build": "mvn -f plugins/catalog/pom.xml -DskipTests package",
    "web": "docker compose --profile dev up -d web-dev",
    "web:build": "npm --prefix src/frontend/web run build",
    "catalog:ui:build": "node scripts/link-plugin-node-modules.mjs && npm --prefix src/frontend/web exec ng build catalog-plugin",
    "mobile": "node scripts/run.mjs mobile",
    "mobile:build": "npm --prefix src/frontend/mobile run build",
    "cli": "node tools/open-erp-cli/bin/open-erp.js",
    "cli:test": "npm --prefix tools/open-erp-cli test",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "i18n:check:strict": "node scripts/check-i18n-parity.mjs --strict",
    "icons:gen": "node scripts/gen-icons.mjs",
    "data:admin-units": "node scripts/gen-admin-units.mjs",
    "data:admin-units:check": "node scripts/check-admin-units.mjs",
    "e2e:plugin": "node scripts/e2e/plugin-cli-e2e.mjs",
    "dev": "docker compose --profile dev up -d --build",
    "predev": "npm run keys:jwt",
    "dev:full": "docker compose --profile dev --profile full up -d --build",
    "predev:full": "npm run keys:jwt",
    "dev:stop": "docker compose --profile dev --profile full down",
    "dev:docker:build": "docker compose --profile dev build",
    "dev:docker": "docker compose --profile dev up -d --build",
    "predev:docker": "npm run keys:jwt",
    "dev:docker:logs": "docker compose --profile dev logs -f backend-dev web-dev catalog-plugin-dev catalog-e2e-dev catalog-system-dev",
    "dev:docker:down": "docker compose --profile dev down",
    "test": "npm run backend:test && npm run cli:test",
    "build": "npm run backend:build && npm run web:build && npm run mobile:build",
    "build:images": "node scripts/run.mjs build-images",
    "deploy:staging": "node scripts/run.mjs deploy-docker",
    "deploy:prod": "node scripts/run.mjs deploy-k8s",
    "clean": "node scripts/run.mjs clean"
  }
}
