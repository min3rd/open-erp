*.pem
*.key
*.p12
*.jks
*.keystore
.env
.env.*

# IDE & Editor files
.idea/
*.iml
.vscode/
.project
.classpath
.settings/
bin/

# OS and Logs
*.log
.DS_Store
Thumbs.db
