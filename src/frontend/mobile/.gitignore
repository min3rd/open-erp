# Frontend Mobile (Ionic 8 + Angular 22 / Tailwind CSS v4) .gitignore

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out
/www
/android
/ios

# Dependencies
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Angular cache & build
/.angular/
.sass-cache/

# Secrets & Environment
.env
.env.*
*.pem
*.keystore
*.jks

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/

# Miscellaneous
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db
