{
  "schema_version": "2.0",
  "id": "form",
  "name": "Form Builder",
  "description": "Thiết kế biểu mẫu kiểu Google Forms: sections, nhiều loại câu hỏi, skip logic, link public, thu và quản lý response, map vào entity.",
  "version": "1.0.0",
  "template_version": "2.0.0",
  "author": "Open-ERP Plugin Team",
  "core_version_compatibility": ">=1.0.0 <2.0.0",
  "migration_policy": "COMPATIBLE",
  "rollback_strategy": "SNAPSHOT_RESTORE",
  "dependencies": [],
  "platforms": {
    "desktop": {
      "supported": true,
      "features": [
        "form:definition:manage",
        "form:response:read",
        "form:response:export"
      ]
    },
    "mobile": {
      "supported": true,
      "features": [
        "form:public:fill"
      ]
    }
  },
  "permissions": [
    {
      "code": "form:definition:manage",
      "name": "Form definition manage"
    },
    {
      "code": "form:response:read",
      "name": "Form response read"
    },
    {
      "code": "form:response:export",
      "name": "Form response export"
    }
