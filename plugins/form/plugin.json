  "entities": [
    {
      "name": "FormDefinition",
      "table": "plg_form_definitions",
      "storage_scope": "TENANT",
      "fields": [
        { "name": "tenant_id", "type": "uuid", "required": true },
        { "name": "slug", "type": "string", "required": true, "max_length": 64 },
        { "name": "title_text", "type": "string", "required": true, "max_length": 300 },
        { "name": "description", "type": "text", "required": false },
        { "name": "document", "type": "json", "required": true },
        { "name": "entity_mapping", "type": "json", "required": false },
        { "name": "publish_status", "type": "enum", "enum_values": ["DRAFT", "PUBLISHED", "CLOSED"], "default": "DRAFT" },
        { "name": "captcha", "type": "enum", "enum_values": ["none", "recaptcha-v3"], "default": "none" },
        { "name": "close_at", "type": "datetime", "required": false },
        { "name": "response_limit", "type": "integer", "required": false },
        { "name": "accept_responses", "type": "bool", "required": true, "default": true },
        { "name": "latest_version", "type": "integer", "required": true, "default": 1 },
        { "name": "created_by", "type": "uuid", "required": false },
        { "name": "created_at", "type": "datetime", "required": false },
        { "name": "updated_at", "type": "datetime", "required": false }
