      "validators": [
        { "field": "slug", "rule": "max_length", "value": 64 },
        { "field": "publish_status", "rule": "enum", "value": ["DRAFT", "PUBLISHED", "CLOSED"] }
      ]
    },
    {
      "name": "FormDefinitionVersion",
      "table": "plg_form_definitions_versions",
      "storage_scope": "TENANT",
