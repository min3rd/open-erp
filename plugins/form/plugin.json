        { "name": "tenant_id", "type": "uuid", "required": true },
        { "name": "definition_id", "type": "uuid", "required": true },
        { "name": "version", "type": "integer", "required": true },
        { "name": "document", "type": "json", "required": true },
        { "name": "entity_mapping", "type": "json", "required": false },
        { "name": "created_at", "type": "datetime", "required": false }
      ]
    },
    {
      "name": "FormResponse",
      "table": "plg_form_responses",
      "storage_scope": "TENANT",
