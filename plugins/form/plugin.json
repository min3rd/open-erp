        { "name": "tenant_id", "type": "uuid", "required": true },
        { "name": "form_id", "type": "uuid", "required": true },
        { "name": "form_version", "type": "integer", "required": true },
        { "name": "answers", "type": "json", "required": true },
        { "name": "responder_email", "type": "string", "required": false, "max_length": 320 },
        { "name": "submitted_by_user_id", "type": "uuid", "required": false },
        { "name": "entity_write_status", "type": "enum", "enum_values": ["SKIPPED", "OK", "FAILED"], "default": "SKIPPED" },
        { "name": "entity_write_error", "type": "text", "required": false },
        { "name": "workflow_instance_id", "type": "uuid", "required": false },
        { "name": "ip_hash", "type": "string", "required": false, "max_length": 64 },
        { "name": "idempotency_key", "type": "string", "required": true, "max_length": 80 },
        { "name": "status", "type": "enum", "enum_values": ["SUBMITTED"], "default": "SUBMITTED" },
        { "name": "submitted_at", "type": "datetime", "required": false }
      ],
      "validators": [
        { "field": "entity_write_status", "rule": "enum", "value": ["SKIPPED", "OK", "FAILED"] }
      ]
    },
    {
      "name": "FormFile",
      "table": "plg_form_files",
      "storage_scope": "TENANT",
      "fields": [
        { "name": "tenant_id", "type": "uuid", "required": true },
        { "name": "form_id", "type": "uuid", "required": true },
        { "name": "response_id", "type": "uuid", "required": false },
        { "name": "storage_key", "type": "string", "required": true, "max_length": 400 },
        { "name": "original_name", "type": "string", "required": true, "max_length": 255 },
        { "name": "content_type", "type": "string", "required": false, "max_length": 120 },
        { "name": "size_bytes", "type": "integer", "required": false },
        { "name": "scan_status", "type": "enum", "enum_values": ["PENDING", "CLEAN", "INFECTED", "ERROR"], "default": "PENDING" },
        { "name": "scan_error", "type": "text", "required": false },
        { "name": "created_at", "type": "datetime", "required": false }
      ],
      "validators": [
        { "field": "scan_status", "rule": "enum", "value": ["PENDING", "CLEAN", "INFECTED", "ERROR"] }
      ]
    }
