        "break_minutes": { "param": "break_minutes", "optional": true },
        "ot_grace_minutes": { "param": "ot_grace_minutes", "optional": true },
        "min_ot_minutes": { "param": "min_ot_minutes", "optional": true },
        "working_minutes": { "param": "working_minutes" },
        "is_active": { "param": "is_active", "optional": true }
