{
  "schema_version": "2.0",
  "id": "attendance",
  "name": "Attendance & Timesheet",
  "description": "Chấm công đa nguồn (web, mobile GPS, kiosk, máy chấm công), ca làm việc, tính công tự động, đơn từ, nghỉ phép, bảng công kỳ và xuất dữ liệu lương.",
  "version": "1.0.0",
  "template_version": "2.0.0",
  "author": "Open-ERP Plugin Team",
  "core_version_compatibility": ">=1.0.0 <2.0.0",
  "migration_policy": "COMPATIBLE",
  "rollback_strategy": "SNAPSHOT_RESTORE",
  "dependencies": [],
  "event_subscriptions": [
    { "source": "workflow", "event": "workflow.instance.completed" }
  ],
  "event_publications": [
    { "event": "attendance.record.needs_review", "entity": "AttendanceRecord" },
    { "event": "attendance.timesheet.locked", "entity": "Timesheet" },
    { "event": "attendance.request.created", "entity": "AttendanceRequest" }
  ],
  "platforms": {
    "desktop": {
      "supported": true,
      "features": [
        "attendance:checkin:self",
        "attendance:log:manage",
        "attendance:kiosk:operate",
        "attendance:shift:manage",
        "attendance:record:read",
        "attendance:record:override",
        "attendance:request:submit",
        "attendance:request:approve",
        "attendance:leave:manage",
        "attendance:timesheet:manage",
        "attendance:timesheet:lock",
        "attendance:timesheet:confirm",
        "attendance:report:read",
        "attendance:settings:manage"
      ]
    },
    "mobile": {
      "supported": true,
      "features": [
        "attendance:checkin:self",
        "attendance:request:submit",
        "attendance:request:approve",
        "attendance:timesheet:confirm"
      ]
    }
  },
  "permissions": [
    { "code": "attendance:checkin:self", "name": "Attendance self check-in/out" },
    { "code": "attendance:log:manage", "name": "Attendance log manage" },
    { "code": "attendance:kiosk:operate", "name": "Attendance kiosk operate" },
    { "code": "attendance:shift:manage", "name": "Attendance shift and schedule manage" },
    { "code": "attendance:record:read", "name": "Attendance record read" },
    { "code": "attendance:record:override", "name": "Attendance record override" },
    { "code": "attendance:request:submit", "name": "Attendance request submit" },
    { "code": "attendance:request:approve", "name": "Attendance request approve" },
    { "code": "attendance:leave:manage", "name": "Attendance leave manage" },
    { "code": "attendance:timesheet:manage", "name": "Attendance timesheet manage" },
    { "code": "attendance:timesheet:lock", "name": "Attendance timesheet lock" },
    { "code": "attendance:timesheet:confirm", "name": "Attendance timesheet confirm" },
    { "code": "attendance:report:read", "name": "Attendance report read" },
    { "code": "attendance:settings:manage", "name": "Attendance settings manage" }
  ],
  "entities": [
