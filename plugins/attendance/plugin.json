        { "name": "grace_out_minutes", "type": "integer", "required": true, "default": 0 },
        { "name": "break_minutes", "type": "integer", "required": true, "default": 0 },
        { "name": "ot_grace_minutes", "type": "integer", "required": true, "default": 0 },
        { "name": "min_ot_minutes", "type": "integer", "required": true, "default": 15 },
        { "name": "working_minutes", "type": "integer", "required": true },
        { "name": "is_active", "type": "bool", "required": true, "default": true },
