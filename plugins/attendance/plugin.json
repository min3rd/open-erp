        "worked_minutes": { "param": "worked_minutes", "optional": true },
        "late_minutes": { "param": "late_minutes", "optional": true },
        "early_leave_minutes": { "param": "early_leave_minutes", "optional": true },
        "ot_minutes": { "param": "ot_minutes", "optional": true },
        "calc_version": { "param": "calc_version", "optional": true },
        "needs_review": { "param": "needs_review", "optional": true },
