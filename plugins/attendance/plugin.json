        { "name": "updated_at", "type": "datetime", "required": false }
      ]
    },
    {
      "name": "AttendanceLog",
      "table": "plg_attendance_logs",
      "storage_scope": "TENANT",
      "fields": [
        { "name": "tenant_id", "type": "uuid", "required": true },
        { "name": "employee_id", "type": "uuid", "required": true },
        { "name": "event_type", "type": "enum", "enum_values": ["IN", "OUT"], "required": true },
        { "name": "occurred_at", "type": "datetime", "required": true },
        { "name": "work_date", "type": "date", "required": true },
        { "name": "source", "type": "enum", "enum_values": ["WEB", "MOBILE", "KIOSK", "IMPORT", "PUSH", "MANUAL"], "required": true },
        { "name": "device_id", "type": "uuid", "required": false },
        { "name": "meta", "type": "json", "required": false },
        { "name": "deleted_by", "type": "uuid", "required": false },
        { "name": "deleted_reason", "type": "text", "required": false },
        { "name": "deleted_at", "type": "datetime", "required": false },
        { "name": "created_at", "type": "datetime", "required": false }
      ],
      "validators": [
        { "field": "event_type", "rule": "enum", "value": ["IN", "OUT"] },
        { "field": "source", "rule": "enum", "value": ["WEB", "MOBILE", "KIOSK", "IMPORT", "PUSH", "MANUAL"] }
      ]
    },
    {
      "name": "AttendanceRecord",
