  "relations": [],
  "queries": [
    {
      "id": "attendance.shift.list",
      "mode": "READ",
      "operation": "LIST",
      "entity": "ShiftDefinition",
      "tenant_scope": "TENANT",
      "select": ["id", "code", "name", "catalog_shift_id", "start_time", "end_time",
        "grace_in_minutes", "grace_out_minutes", "break_minutes", "ot_grace_minutes",
        "min_ot_minutes", "working_minutes", "is_active", "updated_at"],
      "filters": [
        { "field": "is_active", "op": "EQ", "param": "is_active", "optional": true }
      ],
      "sort": [{ "field": "code", "direction": "ASC" }],
      "page": { "pageParam": "page", "sizeParam": "size", "maxSize": 100, "defaultSize": 50 }
    },
