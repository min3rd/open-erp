FROM node:22-alpine

WORKDIR /app

COPY src/frontend/mobile/package.json src/frontend/mobile/package-lock.json ./src/frontend/mobile/
RUN cd src/frontend/mobile && npm ci
RUN ln -s /app/src/frontend/mobile/node_modules /app/node_modules

COPY src/frontend/mobile ./src/frontend/mobile
COPY src/frontend/shared ./src/frontend/shared

WORKDIR /app/src/frontend/mobile

ENV NG_CLI_ANALYTICS=false

EXPOSE 8100

CMD ["npm", "run", "serve", "--", "--host", "0.0.0.0", "--poll", "2000"]
