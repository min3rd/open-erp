# Root .gitignore for Open-ERP

# Environment & Secrets
.env
.env.*
*.pem
*.key
*.p12
*.jks
*.keystore

# Build Outputs & Package Artifacts
**/target/
**/dist/
**/out/
**/out-tsc/
**/bazel-out/
**/tmp/

# Dependency Directories
**/node_modules/
**/.pnpm-store/

# Cache & Metadata
**/.angular/
**/.quarkus/
**/.turbo/
**/.sass-cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editors
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
.settings/
*.sublime-workspace
.history/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Docker Volume / Local Data directories
docker/data/
