# Root .gitignore for Open-ERP

# Environment & Secrets
.env
.env.*
*.pem
*.key
*.p12
*.jks
*.keystore

# Build Outputs & Package Artifacts
**/target/
**/dist/
**/out/
**/out-tsc/
**/bazel-out/
**/tmp/

# Dependency Directories
**/node_modules/
**/.pnpm-store/

# Cache & Metadata
**/.angular/
**/.quarkus/
**/.turbo/
**/.sass-cache/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local dev process tracking (npm run dev)
.dev-pids.json

# IDE & Editors
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
.settings/
*.sublime-workspace
.history/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Docker Volume / Local Data directories
docker/data/

# Local Backups (DB dumps / cutover snapshots — không bao giờ commit)
backups/

# Local Tool State (Command Code)
.commandcode/

# Local Side Projects (không thuộc repo chính)
tools/affiliate-auto/
tools/facebook-affiliate/

# Local Helper Scripts (không đưa vào repo)
scripts/ops/compile-backend.ps1

# Stray Shell Redirect Artifacts
l.includes('signed')
$null
